//2º passo: definindo a classe maçã 
class Macas {

    // 3º passo: indicando características que cada tipo de maçã tem 
    String tipo;
    String cor;
    String formato;
    int peso;
    // 4º passo: definir operações (métodos) que manipulam os atributos
    float calcCalorias () {
        float t = 52f / 100f * peso; 
        return (t);
    }

    // 5º passo: Definindo o CONSTRUTOR da classe

    Macas(String t, String c, String f, int p) {
        tipo = t;
        cor = c;
        formato = f;
        peso = p;

    }
}
